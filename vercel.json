{
  "buildCommand": "npx prisma generate && npx prisma db push schema.prisma --accept-data-loss && npm run build",


  "outputDirectory": ".next",
  "framework": "nextjs",
  "functions": {
    "src/app/api/loan-applications/**/*.ts": {
      "maxDuration": 300
    },
    "src/app/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["iad1"],
  "installCommand": "npm install"
}
